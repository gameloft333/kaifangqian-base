# 开放签 HTTPS Nginx 配置模板
# 用于 Cloudflare Origin Certificate (15年有效期)
# 每个项目独立配置，不影响其他服务
#
# 使用方式:
#   1. 复制此文件: cp nginx-https.conf.template /etc/nginx/sites-available/kaifangqian_gameai_dpdns_org
#   2. 替换占位符: DOMAIN, SUBDOMAIN, SAFE_NAME, SERVICE_PORT, CERT_FILE, KEY_FILE
#   3. 启用: ln -s /etc/nginx/sites-available/kaifangqian_gameai_dpdns_org /etc/nginx/sites-enabled/
#   4. 测试: nginx -t && systemctl restart nginx
#
# 或直接运行: bash setup-https.sh (自动完成以上步骤)

# ── SSL 终结 + 反向代理到前端容器 (8806) ──────────────────────────
server {
    listen 443 ssl http2;
    server_name __SUBDOMAIN__.__DOMAIN__;

    ssl_certificate     __CERT_FILE__;
    ssl_certificate_key __KEY_FILE__;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # 安全头
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options SAMEORIGIN;

    client_max_body_size 100M;

    # ── WebSocket 代理 (扫码登录/人脸识别推送) ──────────────────────
    location /resrun-paas/websocket {
        proxy_pass http://127.0.0.1:__SERVICE_PORT__;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # ── API 代理 (前端容器 nginx 已处理转发到后端 8899) ──────────────
    location /resrun-paas {
        proxy_pass http://127.0.0.1:__SERVICE_PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 30s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # ── SPA 静态文件 (所有子路径) ──────────────────────────────────
    location / {
        proxy_pass http://127.0.0.1:__SERVICE_PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# ── HTTP → HTTPS 重定向 ──────────────────────────────────────────
server {
    listen 80;
    server_name __SUBDOMAIN__.__DOMAIN__;
    return 301 https://$host$request_uri;
}
